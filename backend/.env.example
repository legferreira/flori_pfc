# Copie para .env e preencha. O .env nunca vai para o git.

# SECRET_KEY é obrigatória: o Django não sobe com ela em branco. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Em produção: DEBUG=False e ALLOWED_HOSTS com o domínio.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=

DB_NAME=flori_db
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# E-mails transacionais (Brevo): cadastro, redefinição de senha, código de login.
BREVO_API_KEY=
BREVO_REMETENTE_EMAIL=

# Endereço do front-end, usado nos links dos e-mails.
FRONTEND_URL=http://127.0.0.1:5500

# Login com Google (Firebase). Tem valor padrão no settings.py; só mude se trocar de projeto.
FIREBASE_PROJECT_ID=flori-1742a
