# Copie para .env e preencha. O .env nunca vai para o git.

# SECRET_KEY é obrigatória com DEBUG=False: o Django não sobe com ela em branco. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Em produção: DEBUG=False e ALLOWED_HOSTS com o domínio. Sem DEBUG definido, vale False.
# Com DEBUG=False ficam ligados: redirecionamento para HTTPS, cookies seguros e HSTS.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=

# Origens que podem chamar a API, separadas por vírgula. Em branco, vale o FRONTEND_URL.
CORS_ALLOWED_ORIGINS=
# True só quando a API estiver atrás de um proxy confiável (usa X-Forwarded-For e X-Forwarded-Proto).
CONFIA_EM_X_FORWARDED_FOR=False

DB_NAME=flori_db
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# E-mails transacionais (Brevo): cadastro, redefinição de senha, código de login, exclusão de conta.
BREVO_API_KEY=
BREVO_REMETENTE_EMAIL=

# Endereço do front-end, usado nos links dos e-mails.
FRONTEND_URL=http://127.0.0.1:5500

# Login com Google (Firebase). Tem valor padrão no settings.py; só mude se trocar de projeto.
FIREBASE_PROJECT_ID=flori-1742a

# Usados só pelo comando criar_admin. Prefira deixar a senha em branco: o comando pergunta sem mostrar.
ADMIN_EMAIL=
ADMIN_NOME=
ADMIN_SENHA=

# Prazos, em dias, usados pelo comando anonimizar_logs. Depois deles o registro perde o IP; a linha nunca é apagada.
LOG_RETENCAO_DIAS=365
LOG_RETENCAO_ADMIN_DIAS=1825
CONSENTIMENTO_RETENCAO_DIAS=1825

# False só em servidores que não permitem triggers no MySQL (ex.: PythonAnywhere).
DB_TRIGGERS=True